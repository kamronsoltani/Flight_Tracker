void printCentered(const char* text, int y, uint16_t color) {
  dma_display->setFont(&Org_01);
  dma_display->setTextWrap(false);
  int16_t x1, y1;
  uint16_t w, h;
  dma_display->getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
