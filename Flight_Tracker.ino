// ========== SEARCHING ANIMATION ==========
void drawSearching() {
  static unsigned long lastDotTime = 0;
  static int dotCount = 0;
  static bool forceDraw = true;

  if (forceDraw || millis() - lastDotTime > 500) {
    forceDraw = false;
    dotCount = (dotCount + 1) % 4;
    lastDotTime = millis();

    dma_display->fillScreen(COL_BLACK);
    printCentered("Searching", 14, COL_WHITE);

    char dots[5] = "";
    for (int i = 0; i < dotCount; i++) strcat(dots, ".");
    if (dotCount > 0) printCentered(dots, 24, COL_ORANGE);
  }
}

