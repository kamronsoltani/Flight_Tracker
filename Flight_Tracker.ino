  if (line2) printCentered(line2, 22, COL_WHITE);
}

// ========== HELPERS ==========
float calculateDistance(float lat1, float lon1, float lat2, float lon2) {
  float R = 3959.0;
  float dLat = (lat2 - lat1) * PI / 180.0;
  float dLon = (lon2 - lon1) * PI / 180.0;
  float a = sin(dLat / 2) * sin(dLat / 2) + cos(lat1 * PI / 180.0) * cos(lat2 * PI / 180.0) * sin(dLon / 2) * sin(dLon / 2);
  return R * 2 * atan2(sqrt(a), sqrt(1 - a));
}

const char* getCardinalDirection(int heading) {
  if (heading >= 337 || heading < 23) return "N";
  if (heading >= 23 && heading < 68) return "NE";
  if (heading >= 68 && heading < 113) return "E";
  if (heading >= 113 && heading < 158) return "SE";
  if (heading >= 158 && heading < 203) return "S";
  if (heading >= 203 && heading < 248) return "SW";
  if (heading >= 248 && heading < 293) return "W";
  if (heading >= 293 && heading < 337) return "NW";
  return "N";
}

// ========== HEADING ARROW ==========
void drawHeadingArrow(int cx, int cy, int heading, uint16_t color) {
  if (cx < 3) cx = 3;
  if (cx > PANEL_RES_X - 4) cx = PANEL_RES_X - 4;
  if (cy < 3) cy = 3;
  if (cy > PANEL_RES_Y - 4) cy = PANEL_RES_Y - 4;

  int dir = ((heading + 22) / 45) % 8;

  const int8_t shafts[8][4] = {
    { 0, 2, 0, -2 },
    { -2, 2, 2, -2 },
    { -2, 0, 2, 0 },
    { -2, -2, 2, 2 },
    { 0, -2, 0, 2 },
    { 2, -2, -2, 2 },
    { 2, 0, -2, 0 },
    { 2, 2, -2, -2 },
  };
  const int8_t wings[8][4] = {
    { -1, 1, 1, 1 },
    { 0, 2, -2, 0 },
    { -1, -1, -1, 1 },
    { -2, 0, 0, -2 },
    { -1, -1, 1, -1 },
    { 0, -2, 2, 0 },
    { 1, -1, 1, 1 },
    { 2, 0, 0, 2 },
  };

  int bx = cx + shafts[dir][0], by = cy + shafts[dir][1];
  int tx = cx + shafts[dir][2], ty = cy + shafts[dir][3];

  dma_display->drawLine(bx, by, tx, ty, color);
  dma_display->drawPixel(tx + wings[dir][0], ty + wings[dir][1], color);
  dma_display->drawPixel(tx + wings[dir][2], ty + wings[dir][3], color);
}

// ========== HTTP HELPERS ==========
// TLS needs ~40KB stack + contiguous heap. HUB75 DMA drops free heap hard, so:
//  1) a permanent HTTPS worker with a STATIC 48KB stack (never fails to spawn)
//  2) first flight fetch runs BEFORE the panel starts
static const char* HTTP_UA =
    "Mozilla/5.0 (ESP32; FlightTracker) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";

static JsonDocument gAdsbDoc;
static char gFetchUrl[288];
static String* gFetchPayload = nullptr;
static volatile int gFetchResult = 0;   // 0=pending, 1=ok, -1=fail
static volatile int gFetchHttpCode = 0;
enum FetchMode : uint8_t { FETCH_JSON = 0, FETCH_STRING = 1 };
static FetchMode gFetchMode = FETCH_JSON;

static constexpr uint32_t HTTPS_STACK_WORDS = 12288;  // 48KB
static StackType_t gHttpsStack[HTTPS_STACK_WORDS];
static StaticTask_t gHttpsTaskMem;
static TaskHandle_t gHttpsTask = nullptr;
static SemaphoreHandle_t gHttpsGo = nullptr;
static SemaphoreHandle_t gHttpsDone = nullptr;

static void applyPublicDns() {
  WiFi.config(INADDR_NONE, INADDR_NONE, INADDR_NONE,
              IPAddress(8, 8, 8, 8), IPAddress(1, 1, 1, 1));
}

bool ensureWifi() {
  if (WiFi.status() == WL_CONNECTED) return true;
  Serial.println("WiFi lost — reconnecting...");
  WiFi.disconnect(false, false);
  delay(200);
  applyPublicDns();
  WiFi.begin(ssid, password);
  for (int i = 0; i < 30; i++) {
    if (WiFi.status() == WL_CONNECTED) {
      Serial.printf("WiFi reconnected, IP=%s DNS=%s heap=%u\n",
                    WiFi.localIP().toString().c_str(),
                    WiFi.dnsIP().toString().c_str(),
                    ESP.getFreeHeap());
      return true;
    }
    delay(500);
  }
  Serial.println("WiFi reconnect failed");
  return false;
}

static void logNetDiag(const char* host) {
  Serial.printf("Net: IP=%s GW=%s DNS=%s RSSI=%d heap=%u maxAlloc=%u\n",
                WiFi.localIP().toString().c_str(),
                WiFi.gatewayIP().toString().c_str(),
                WiFi.dnsIP().toString().c_str(),
                WiFi.RSSI(),
                ESP.getFreeHeap(),
                ESP.getMaxAllocHeap());
  if (!host || !host[0]) return;
  IPAddress ip;
  if (WiFi.hostByName(host, ip)) {
    Serial.printf("DNS %s -> %s\n", host, ip.toString().c_str());
    WiFiClient plain;
    Serial.printf("Plain TCP :443 ... ");
    if (plain.connect(ip, 443, 8000)) {
      Serial.println("OK");
      plain.stop();
    } else {
      Serial.println("FAIL — campus network may be blocking outbound HTTPS");
    }
  } else {
    Serial.printf("DNS FAILED for %s\n", host);
  }
}

static const char* hostFromUrl(const char* url, char* buf, size_t buflen) {
  buf[0] = '\0';
  const char* p = strstr(url, "://");
  if (!p) return buf;
  p += 3;
  const char* slash = strchr(p, '/');
  size_t n = slash ? (size_t)(slash - p) : strlen(p);
  if (n >= buflen) n = buflen - 1;
  memcpy(buf, p, n);
  buf[n] = '\0';
  char* colon = strchr(buf, ':');
  if (colon) *colon = '\0';
  return buf;
}

static bool httpsWorkOnThisTask() {
  mqttPauseForFetch();

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(20000);

  HTTPClient http;
  http.setConnectTimeout(20000);
  http.setTimeout(30000);
  http.setReuse(false);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setUserAgent(HTTP_UA);
  http.useHTTP10(true);

  bool ok = false;
  do {
    if (!http.begin(client, gFetchUrl)) {
      Serial.println("HTTP begin failed");
      break;
    }
    http.addHeader("Accept", "application/json");
    http.addHeader("Accept-Encoding", "identity");
    http.addHeader("Connection", "close");

    int code = http.GET();
    gFetchHttpCode = code;
    if (code != 200) {
      Serial.printf("HTTP %d (%s)\n", code, HTTPClient::errorToString(code).c_str());
      char host[64];
      logNetDiag(hostFromUrl(gFetchUrl, host, sizeof(host)));
      http.end();
      break;
    }

    String body = http.getString();
    http.end();
    client.stop();
    Serial.printf("HTTP body %u bytes, heap=%u\n", body.length(), ESP.getFreeHeap());
    if (body.length() < 2) {
      Serial.println("Empty HTTP body");
      break;
    }

    if (gFetchMode == FETCH_STRING) {
      if (!gFetchPayload) break;
      *gFetchPayload = body;
      ok = true;
      break;
    }

    gAdsbDoc.clear();
    DeserializationError err = deserializeJson(gAdsbDoc, body);
    body = String();
    if (err) {
      Serial.printf("JSON err: %s heap=%u\n", err.c_str(), ESP.getFreeHeap());
      break;
    }

    size_t nAc = 0;
    if (gAdsbDoc["ac"].is<JsonArray>()) nAc = gAdsbDoc["ac"].as<JsonArray>().size();
    else if (gAdsbDoc["aircraft"].is<JsonArray>()) nAc = gAdsbDoc["aircraft"].as<JsonArray>().size();
    else if (gAdsbDoc["states"].is<JsonArray>()) nAc = gAdsbDoc["states"].as<JsonArray>().size();
    Serial.printf("Parse ok — %u aircraft/states, heap=%u\n", (unsigned)nAc, ESP.getFreeHeap());
    ok = true;
  } while (false);

  mqttResumeAfterFetch();
  return ok;
}

static void httpsWorkerLoop(void*) {
  for (;;) {
    if (xSemaphoreTake(gHttpsGo, portMAX_DELAY) != pdTRUE) continue;
    bool ok = httpsWorkOnThisTask();
    gFetchResult = ok ? 1 : -1;
    xSemaphoreGive(gHttpsDone);
  }
}

void startHttpsWorker() {
  if (gHttpsTask) return;
  gHttpsGo = xSemaphoreCreateBinary();
  gHttpsDone = xSemaphoreCreateBinary();
  gHttpsTask = xTaskCreateStaticPinnedToCore(
      httpsWorkerLoop, "httpsW", HTTPS_STACK_WORDS, nullptr, 1,
      gHttpsStack, &gHttpsTaskMem, 0);
  Serial.printf("HTTPS worker started (static 48KB stack), heap=%u\n", ESP.getFreeHeap());
}

static bool runHttpsJob() {
  if (!gHttpsTask) {
    Serial.println("HTTPS worker missing");
    return false;
  }
  gFetchResult = 0;
  gFetchHttpCode = 0;
  xSemaphoreGive(gHttpsGo);
  if (xSemaphoreTake(gHttpsDone, pdMS_TO_TICKS(45000)) != pdTRUE) {
    Serial.println("https worker timed out");
    return false;
  }
  return gFetchResult == 1;
}

bool httpGet(const String& url, String& payload, int timeoutMs = 15000) {
  (void)timeoutMs;
  if (!ensureWifi()) return false;
  if (url.length() >= sizeof(gFetchUrl)) return false;
  strncpy(gFetchUrl, url.c_str(), sizeof(gFetchUrl) - 1);
  gFetchUrl[sizeof(gFetchUrl) - 1] = '\0';
  gFetchMode = FETCH_STRING;
  gFetchPayload = &payload;
  bool ok = runHttpsJob();
  gFetchPayload = nullptr;
  return ok;
}

bool fetchAdsbJson(const String& url) {
  if (!ensureWifi()) return false;
  if (url.length() >= sizeof(gFetchUrl)) return false;
  strncpy(gFetchUrl, url.c_str(), sizeof(gFetchUrl) - 1);
  gFetchUrl[sizeof(gFetchUrl) - 1] = '\0';
  gFetchMode = FETCH_JSON;
  Serial.printf("Fetch start heap=%u maxAlloc=%u\n", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
  Serial.println(gFetchUrl);
  return runHttpsJob();
}

static int jsonAltitudeFt(JsonVariant ac) {
  if (ac["alt_baro"].is<const char*>()) {
    const char* s = ac["alt_baro"];
    if (!s || strcmp(s, "ground") == 0) return 0;
  } else if (!ac["alt_baro"].isNull()) {
    int a = ac["alt_baro"].as<int>();
    if (a != 0) return a;
  }
  if (!ac["alt_geom"].isNull() && !ac["alt_geom"].is<const char*>()) {
    return ac["alt_geom"].as<int>();
  }
  return 0;
}

// ========== ROUTE LOOKUP ==========
bool getRouteFromADSBDB(const char* callsign, int altitude,
                        char* origin, char* destination, bool* isIntl) {
  *isIntl = false;

  for (int i = 0; i < MAX_CACHE; i++) {
    if (routeCache[i].valid && strcmp(routeCache[i].callsign, callsign) == 0) {
      if (millis() - routeCache[i].timestamp < 3600000UL) {
        strcpy(origin, routeCache[i].origin);
        strcpy(destination, routeCache[i].destination);
        *isIntl = routeCache[i].isInternational;
        return true;
      }
    }
  }

  String payload;
  String url = "https://api.adsbdb.com/v0/callsign/" + String(callsign);
  if (!httpGet(url, payload, 8000)) {
    return false;
  }

  JsonDocument doc;
  if (!deserializeJson(doc, payload) && doc["response"].is<JsonObject>()) {
    JsonObject response = doc["response"];
    if (response.containsKey("flightroute")) {
      JsonObject flightroute = response["flightroute"];

      char tempOrigin[5] = "", tempDest[5] = "";
      bool hasOrigin = false, hasDest = false, isInternational = false;

      if (flightroute.containsKey("origin")) {
        JsonObject o = flightroute["origin"];
        if (o.containsKey("iata_code")) {
          const char* orig = o["iata_code"];
          if (orig && strlen(orig) >= 3) {
            strncpy(tempOrigin, orig, 3);
            tempOrigin[3] = '\0';
            hasOrigin = true;
          }
        }
        if (o.containsKey("country_iso_name")) {
          const char* c = o["country_iso_name"];
          if (c && strcmp(c, "US") != 0) isInternational = true;
        }
      }

      if (flightroute.containsKey("destination")) {
        JsonObject d = flightroute["destination"];
        if (d.containsKey("iata_code")) {
          const char* dest = d["iata_code"];
          if (dest && strlen(dest) >= 3) {
            strncpy(tempDest, dest, 3);
            tempDest[3] = '\0';
            hasDest = true;
          }
        }
        if (d.containsKey("country_iso_name")) {
          const char* c = d["country_iso_name"];
          if (c && strcmp(c, "US") != 0) isInternational = true;
        }
      }

      if (hasOrigin && hasDest) {
        strcpy(origin, tempOrigin);
        strcpy(destination, tempDest);
        *isIntl = isInternational;

        RouteCache* slot = &routeCache[cacheIndex];
        cacheIndex = (cacheIndex + 1) % MAX_CACHE;
        strncpy(slot->callsign, callsign, 15);
        slot->callsign[15] = '\0';
        strncpy(slot->origin, tempOrigin, 3);
        slot->origin[3] = '\0';
        strncpy(slot->destination, tempDest, 3);
        slot->destination[3] = '\0';
        slot->isInternational = isInternational;
        slot->timestamp = millis();
        slot->valid = true;
        return true;
      }
    }
  }

  return false;
}

// ========== FLIGHT FETCH ==========
void getFlights() {
  int apiRadius = SEARCH_RADIUS;
  if (apiRadius > ADSB_API_RADIUS_CAP) apiRadius = ADSB_API_RADIUS_CAP;
  if (apiRadius < 5) apiRadius = 5;

  String lat = String(MY_LAT, 6);
  String lon = String(MY_LON, 6);
  String dist = String(apiRadius);

  String urlLol = "https://api.adsb.lol/v2/lat/" + lat + "/lon/" + lon + "/dist/" + dist;
  String urlFi  = "https://opendata.adsb.fi/api/v2/lat/" + lat + "/lon/" + lon + "/dist/" + dist;

  JsonDocument& doc = gAdsbDoc;

  // adsb.fi first — more reliable from ESP; lol as fallback; OpenSky last.
  bool ok = fetchAdsbJson(urlFi);
  if (!ok) {
    Serial.println("adsb.fi failed — trying adsb.lol...");
    ok = fetchAdsbJson(urlLol);
  }
  if (!ok) {
    Serial.println("adsb.lol failed — trying OpenSky...");
    float dLat = apiRadius / 60.0f;
    float cosLat = cosf(MY_LAT * 0.0174532925f);
    if (cosLat < 0.2f) cosLat = 0.2f;
    float dLon = apiRadius / (60.0f * cosLat);
    String urlOs = "https://opensky-network.org/api/states/all"
                   "?lamin=" + String(MY_LAT - dLat, 4) +
                   "&lomin=" + String(MY_LON - dLon, 4) +
                   "&lamax=" + String(MY_LAT + dLat, 4) +
                   "&lomax=" + String(MY_LON + dLon, 4);
    ok = fetchAdsbJson(urlOs);
    if (!ok) {
      Serial.println("ADSB failed on all providers");
      return;
    }
  }

  // --- Step 2: Parse into lightweight raw structs, then free the doc ---
  struct RawFlight {
    char  callsign[16];
    char  aircraftType[16];
    float lat, lon;
    int   altitude, speed, heading, vertRate;
  };
  RawFlight raw[10];
  int rawCount = 0;

  {
    JsonArray aircraft;
    if (doc["ac"].is<JsonArray>()) {
      aircraft = doc["ac"].as<JsonArray>();
    } else if (doc["aircraft"].is<JsonArray>()) {
      aircraft = doc["aircraft"].as<JsonArray>();
    }

    if (!aircraft.isNull() && aircraft.size() > 0) {
      Serial.printf("Local ADS-B: %u aircraft\n", aircraft.size());
      for (JsonVariant ac : aircraft) {
        if (rawCount >= 10) break;

        String callsign = ac["flight"].as<String>();
        callsign.trim();
        callsign.toUpperCase();
        if (callsign.length() == 0) continue;

        if (!isCommercialCallsign(callsign.c_str())) {
          continue;
        }

        float flat = ac["lat"].as<float>();
        float flon = ac["lon"].as<float>();
        if (flat == 0 && flon == 0) continue;

        int altitude = jsonAltitudeFt(ac);
        if (altitude < MIN_ALTITUDE) continue;

        String aircraftType = ac["t"].as<String>();
        aircraftType.trim();
        aircraftType.toUpperCase();
        if (aircraftType.length() == 0) continue;

        if (isBlockedType(aircraftType.c_str())) continue;

        int speed    = ac["gs"].as<int>();
        int heading  = ac["track"].as<int>();
        int vertRate = ac["baro_rate"].as<int>();
        if (speed <= 0) continue;

        strncpy(raw[rawCount].callsign,     callsign.c_str(),     15); raw[rawCount].callsign[15]     = '\0';
        strncpy(raw[rawCount].aircraftType, aircraftType.c_str(), 15); raw[rawCount].aircraftType[15] = '\0';
        raw[rawCount].lat      = flat;
        raw[rawCount].lon      = flon;
        raw[rawCount].altitude = altitude;
        raw[rawCount].speed    = speed;
        raw[rawCount].heading  = heading;
        raw[rawCount].vertRate = vertRate;
        rawCount++;
      }
    } else if (doc["states"].is<JsonArray>()) {
      // OpenSky: [icao24, callsign, country, time_pos, last, lon, lat, baro_alt_m,
      //           on_ground, velocity_mps, true_track, vert_rate_mps, ...]
      JsonArray states = doc["states"].as<JsonArray>();
      Serial.printf("OpenSky: %u states\n", states.size());
      for (JsonVariant st : states) {
        if (rawCount >= 10) break;
        if (!st.is<JsonArray>()) continue;
        JsonArray row = st.as<JsonArray>();
        if (row.size() < 11) continue;
        if (row[8].as<bool>()) continue;  // on_ground

        String callsign = row[1].as<String>();
        callsign.trim();
        callsign.toUpperCase();
        if (callsign.length() == 0) continue;
        if (!isCommercialCallsign(callsign.c_str())) continue;

        float flon = row[5].as<float>();
        float flat = row[6].as<float>();
        if (flat == 0 && flon == 0) continue;

        float altM = row[7].isNull() ? 0 : row[7].as<float>();
        int altitude = (int)(altM * 3.28084f);
        if (altitude < MIN_ALTITUDE) continue;

        float vel = row[9].isNull() ? 0 : row[9].as<float>();
        int speed = (int)(vel * 1.94384f);  // m/s -> knots
        if (speed <= 0) continue;

        int heading = row[10].isNull() ? 0 : (int)row[10].as<float>();
        float vr = row[11].isNull() ? 0 : row[11].as<float>();
        int vertRate = (int)(vr * 196.85f);  // m/s -> ft/min approx

        strncpy(raw[rawCount].callsign, callsign.c_str(), 15);
        raw[rawCount].callsign[15] = '\0';
        // OpenSky has no type code — use placeholder so display still works
        strncpy(raw[rawCount].aircraftType, "JET", 15);
        raw[rawCount].aircraftType[15] = '\0';
        raw[rawCount].lat      = flat;
        raw[rawCount].lon      = flon;
        raw[rawCount].altitude = altitude;
        raw[rawCount].speed    = speed;
        raw[rawCount].heading  = heading;
        raw[rawCount].vertRate = vertRate;
        rawCount++;
      }
    } else {
      Serial.println("No aircraft in response");
      return;
    }
  }
  doc.clear();
  doc.shrinkToFit();

  Serial.printf("Raw candidates: %d\n", rawCount);
  if (rawCount == 0) {
    Serial.println("No commercial flights found, keeping previous list");
    return;
  }

  // --- Step 3: Route lookups — heap is free of the big JSON doc ---
  Flight tempFlights[10];
  int tempTotal = 0;

  for (int i = 0; i < rawCount; i++) {
    char origin[5] = "", destination[5] = "";
    bool isIntl = false;
    if (ESP.getFreeHeap() > 90000) {
      getRouteFromADSBDB(raw[i].callsign, raw[i].altitude, origin, destination, &isIntl);
    }

    strncpy(tempFlights[tempTotal].callsign,     raw[i].callsign,     15); tempFlights[tempTotal].callsign[15]     = '\0';
    strncpy(tempFlights[tempTotal].aircraftType, raw[i].aircraftType, 15); tempFlights[tempTotal].aircraftType[15] = '\0';
    strncpy(tempFlights[tempTotal].origin,       origin,               4); tempFlights[tempTotal].origin[4]        = '\0';
    strncpy(tempFlights[tempTotal].destination,  destination,          4); tempFlights[tempTotal].destination[4]   = '\0';
    tempFlights[tempTotal].altitude        = raw[i].altitude;
    tempFlights[tempTotal].speed           = raw[i].speed;
    tempFlights[tempTotal].heading         = raw[i].heading;
    tempFlights[tempTotal].verticalRate    = raw[i].vertRate;
    tempFlights[tempTotal].distance        = calculateDistance(MY_LAT, MY_LON, raw[i].lat, raw[i].lon);
    tempFlights[tempTotal].isInternational = isIntl;

    Serial.printf("✈ %s | %s | %dft | %dkt | %d° %s | intl:%d\n",
                  tempFlights[tempTotal].callsign,
                  tempFlights[tempTotal].aircraftType,
                  tempFlights[tempTotal].altitude,
                  tempFlights[tempTotal].speed,
                  tempFlights[tempTotal].heading,
                  getCardinalDirection(tempFlights[tempTotal].heading),
                  tempFlights[tempTotal].isInternational);
    tempTotal++;
    delay(300);
  }

  // --- Step 4: Commit results atomically ---
  if (tempTotal > 0) {
    memcpy(currentFlights, tempFlights, sizeof(Flight) * tempTotal);
    totalFlights = tempTotal;
    if (currentDisplayFlight >= totalFlights) currentDisplayFlight = 0;
    Serial.printf("✅ %d commercial flights ready\n", totalFlights);
  } else {
    Serial.println("⚠️  No commercial flights found, keeping previous list");
  }
}

// ========== DISPLAY ==========
void drawStaticContent(int index) {
  Flight* f = &currentFlights[index];

  if (strlen(f->aircraftType) == 0) {
    drawSearching();
    return;
  }

  dma_display->fillScreen(COL_BLACK);
  dma_display->setTextWrap(false);
  dma_display->setFont(&Org_01);
  dma_display->setTextColor(COL_WHITE);
  dma_display->setCursor(22, 5);
  dma_display->print(f->callsign);
  dma_display->setTextColor(COL_YELLOW);
  dma_display->setCursor(22, 13);
  dma_display->print(f->aircraftType);
  dma_display->setTextColor(COL_ORANGE);
  dma_display->setCursor(22, 21);

bool hasRoute = (strlen(f->origin) > 0 && strlen(f->destination) > 0);
bool hasSFO   = (strcmp(f->origin, "SFO") == 0 || strcmp(f->destination, "SFO") == 0);

if (hasRoute && (f->isInternational || hasSFO)) {
    char routeText[12];
    snprintf(routeText, sizeof(routeText), "%s-%s", f->origin, f->destination);
    dma_display->print(routeText);
} else {
    dma_display->print("Domestic");
}



// --- Logo / Fallback rendering ---
  Airline* airline = findAirlineLogo(f->callsign);
  if (airline && airline->logo != nullptr) {
    // Known airline: RGB565 bitmap
    dma_display->drawRGBBitmap(airline->xOff, airline->yOff,
                               airline->logo, airline->w, airline->h);
  } else {
    // Unknown airline or null logo: generic 1-bit airplane silhouette (19x20, white)
    dma_display->drawBitmap(0, 1,
                            logo_generic_plane,
                            19, 20,
                            COL_WHITE);
  }
}

void drawColoredMetric(const char* label, const char* value, const char* unit) {
  dma_display->fillRect(0, 23, PANEL_RES_X, 9, COL_BLACK);
  dma_display->setFont(&Org_01);
  dma_display->setTextWrap(false);

  int16_t x1, y1;
  uint16_t w, h;

  // Label anchored at x=0
  dma_display->setTextColor(COL_ORANGE);
  dma_display->setCursor(0, 29);
  dma_display->print(label);

  // Value fixed at x=22
  int cursorX = 22;
  dma_display->setTextColor(COL_WHITE);
  dma_display->setCursor(cursorX, 29);
  dma_display->print(value);
  dma_display->getTextBounds(value, 0, 0, &x1, &y1, &w, &h);
  cursorX += (int)w + 3;

  // Unit 3px after value
  dma_display->setTextColor(COL_YELLOW);
  dma_display->setCursor(cursorX, 29);
  dma_display->print(unit);
}

void drawHeadingMetric(int heading) {
  dma_display->fillRect(0, 23, PANEL_RES_X, 9, COL_BLACK);
  dma_display->setFont(&Org_01);
  dma_display->setTextWrap(false);

  char valueStr[8];
  snprintf(valueStr, sizeof(valueStr), "%d", heading);
  const char* cardinal = getCardinalDirection(heading);

  int16_t x1, y1;
  uint16_t w, h;

  // Label anchored at x=0
  dma_display->setTextColor(COL_ORANGE);
  dma_display->setCursor(0, 29);
  dma_display->print("HDG:");

  // Value fixed at x=22
  int cursorX = 22;
  dma_display->setTextColor(COL_WHITE);
  dma_display->setCursor(cursorX, 29);
  dma_display->print(valueStr);
  dma_display->getTextBounds(valueStr, 0, 0, &x1, &y1, &w, &h);
  cursorX += (int)w + 3;

  // Cardinal 3px after value
  dma_display->setTextColor(COL_YELLOW);
  dma_display->setCursor(cursorX, 29);
  dma_display->print(cardinal);
  dma_display->getTextBounds(cardinal, 0, 0, &x1, &y1, &w, &h);
  cursorX += (int)w + 5;

  // Arrow 3px after cardinal
  int arrowX = cursorX;
  if (arrowX > PANEL_RES_X - 7) arrowX = PANEL_RES_X - 7;
  drawHeadingArrow(arrowX, 27, heading, COL_ORANGE);
}




void showMetric(int flightIndex, int metricIndex) {
  Flight* f = &currentFlights[flightIndex];
  char valueBuf[16];

  switch (metricIndex) {
    case 0:
      snprintf(valueBuf, sizeof(valueBuf), "%d", f->altitude);
      drawColoredMetric("ALT:", valueBuf, "ft");
      break;
    case 1:
      snprintf(valueBuf, sizeof(valueBuf), "%d", f->speed);
      drawColoredMetric("SPD:", valueBuf, "kt");
      break;
    case 2:
      drawHeadingMetric(f->heading);
      break;
  }
}

// ========== WIFI ==========
const char* wifiStatusText(wl_status_t status) {
  switch (status) {
    case WL_IDLE_STATUS:     return "IDLE";
    case WL_NO_SSID_AVAIL:   return "NO_SSID (network not found)";
    case WL_SCAN_COMPLETED:  return "SCAN_COMPLETED";
    case WL_CONNECTED:       return "CONNECTED";
    case WL_CONNECT_FAILED:  return "CONNECT_FAILED (bad password/MAC?)";
    case WL_CONNECTION_LOST: return "CONNECTION_LOST";
    case WL_DISCONNECTED:    return "DISCONNECTED";
    default:                 return "UNKNOWN";
  }
}

bool connectWifi() {
  // IMPORTANT: call this BEFORE dma_display->begin().
  // HUB75 I2S DMA started first often makes WiFi scan return 0 networks.
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.disconnect(true, true);
  delay(500);

  Serial.printf("ESP32 MAC (wifi-keys): %s\n", WiFi.macAddress().c_str());
  Serial.printf("Target SSID: \"%s\"\n", ssid);
  Serial.println("Scanning 2.4GHz networks...");

  // ESP32 classic is 2.4GHz only. iPhone hotspot needs "Maximize Compatibility".
  int n = WiFi.scanNetworks(/*async=*/false, /*hidden=*/true);
  Serial.printf("Scan found %d network(s):\n", n);
  bool found = false;
  for (int i = 0; i < n; i++) {
    String name = WiFi.SSID(i);
    Serial.printf("  [%d] \"%s\"  RSSI=%d  ch=%d\n",
                  i, name.c_str(), WiFi.RSSI(i), WiFi.channel(i));
    if (name == ssid) found = true;
  }
  WiFi.scanDelete();

  if (n <= 0) {
    Serial.println("Radio saw zero APs. Check antenna / board power / Maximize Compatibility on iPhone.");
    return false;
  }
  if (!found) {
    Serial.printf("Target \"%s\" not in list — update ssid/password in sketch to match hotspot or Berkeley-IoT.\n", ssid);
    return false;
  }

  Serial.printf("Connecting to \"%s\"...\n", ssid);
  applyPublicDns();
  WiFi.begin(ssid, password);

  const int maxAttempts = 60;  // ~30s
  for (int attempts = 0; attempts < maxAttempts; attempts++) {
    wl_status_t st = WiFi.status();
    if (st == WL_CONNECTED) {
      Serial.printf("\nWiFi OK  IP=%s  DNS=%s  RSSI=%d\n",
                    WiFi.localIP().toString().c_str(),
                    WiFi.dnsIP().toString().c_str(),
                    WiFi.RSSI());
      return true;
    }
    if (st == WL_CONNECT_FAILED) {
      Serial.printf("\nAuth failed: %s (wrong password?)\n", wifiStatusText(st));
      WiFi.disconnect(true, true);
      delay(500);
      applyPublicDns();
      WiFi.begin(ssid, password);
    }
    Serial.print(".");
    delay(500);
  }

  Serial.printf("\nWiFi FAILED: %s\n", wifiStatusText(WiFi.status()));
  return false;
}

// ========== SETUP ==========
void setup() {
  Serial.begin(115200);
  Serial.setTimeout(50);
  delay(500);

  for (int i = 0; i < MAX_CACHE; i++) routeCache[i].valid = false;

  // WiFi before HUB75 so scans work; panel comes up right after for boot UI.
  bool wifiOk = connectWifi();

  HUB75_I2S_CFG::i2s_pins _pins = {
    R1_PIN, G1_PIN, B1_PIN, R2_PIN, G2_PIN, B2_PIN,
    A_PIN, B_PIN, C_PIN, D_PIN, E_PIN,
    LAT_PIN, OE_PIN, CLK_PIN
  };

  HUB75_I2S_CFG mxconfig(PANEL_RES_X, PANEL_RES_Y, PANEL_CHAIN, _pins);
  dma_display = new MatrixPanel_I2S_DMA(mxconfig);
  dma_display->begin();
  dma_display->setBrightness8(255);
  dma_display->clearScreen();

  COL_ORANGE = dma_display->color565(255, 140, 0);
  COL_YELLOW = dma_display->color565(255, 220, 0);

  if (!wifiOk) {
    drawBootStatus("WiFi Failed", "See Serial");
    for (;;)
      ;
  }

  setupCloudControl();
  drawBootStatus("Connected!", nullptr);
  delay(900);

  startHttpsWorker();
  drawBootStatus("Loading", "flights");
  Serial.println("\n=== First fetch ===");
  getFlights();
  gAdsbDoc.clear();
  gAdsbDoc.shrinkToFit();
  Serial.printf("After first fetch heap=%u flights=%d\n", ESP.getFreeHeap(), totalFlights);
  applyPanelOutput();

  if (totalFlights == 0 && panelShouldShow()) {
    drawBootStatus("Searching", "...");
  }
}

// ========== LOOP ==========
void loop() {
  mqttLoop();

  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    if (!handleSerialPanelCommand(cmd)) {
      // ignore unknown
    }
  }

  static unsigned long lastFetch = millis();
  static unsigned long metricShownAt = 0;
  static int currentMetric = 0;
  static int lastFlight = -1;

  if (millis() - lastFetch > 10000) {
    Serial.println("\n📡 Fetching...");
    if (totalFlights == 0 && panelShouldShow()) drawBootStatus("Loading", "flights");
    getFlights();
    lastFetch = millis();
    applyPanelOutput();
  }

  // Scheduled / manual off — keep MQTT alive, blank the matrix
  if (!panelShouldShow()) {
    delay(50);
    return;
  }

  if (totalFlights == 0) {
    drawSearching();
    delay(50);
    return;
  }

  if (currentDisplayFlight != lastFlight) {
    currentMetric = 0;
    drawStaticContent(currentDisplayFlight);
    showMetric(currentDisplayFlight, currentMetric);
    metricShownAt = millis();
    lastFlight = currentDisplayFlight;
  }

  if (millis() - metricShownAt >= METRIC_HOLD_MS) {
    currentMetric++;

    if (currentMetric >= NUM_METRICS) {
      currentMetric = 0;
      currentDisplayFlight = (currentDisplayFlight + 1) % totalFlights;
    } else {
      showMetric(currentDisplayFlight, currentMetric);
    }

    metricShownAt = millis();
  }

  delay(50);
}



