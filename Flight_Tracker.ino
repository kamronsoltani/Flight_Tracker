bool isCommercialCallsign(const char* callsign) {
  for (int i = 0; i < NUM_COMMERCIAL; i++) {
    int len = strlen(COMMERCIAL_PREFIXES[i]);
    if (strncmp(callsign, COMMERCIAL_PREFIXES[i], len) == 0 && isdigit(callsign[len])) {
      return true;
    }
  }
  return false;
}

bool isBlockedType(const char* acType) {
  for (int i = 0; i < NUM_BLOCKED; i++) {
    if (strcmp(acType, BLOCKED_TYPES[i]) == 0) return true;
  }
  return false;
}

